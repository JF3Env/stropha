#!/bin/sh
# Ensure the shared stropha-mcp server is running.
# Call this from your shell profile, a LaunchAgent, or before starting
# an MCP client that connects via URL.
#
# Usage:
#   bin/stropha-mcp-ensure          # start if not running
#   bin/stropha-mcp-ensure --stop   # stop the running server
#   bin/stropha-mcp-ensure --status # check if running
#
# Local Postgres (pgvector) container management is strictly opt-in:
#   STROPHA_USE_POSTGRES=1 bin/stropha-mcp-ensure
# Without that flag, the daemon connects to the configured DSN without touching
# Docker, including when the `postgres` storage adapter is selected.
# Connection params (port/user/password/db) are read from the config `dsn:` so
# the container always matches what stropha connects to; STROPHA_PG_* override.
# Data persists in a named Docker volume across restarts.

set -e

PORT="${STROPHA_MCP_PORT:-9741}"
HOST="${STROPHA_MCP_HOST:-127.0.0.1}"
PIDFILE="${HOME}/.cache/stropha/mcp-server.pid"
LOGFILE="${HOME}/.cache/stropha/mcp-server.log"

# --- Postgres (pgvector) bring-up --------------------------------------------
# STROPHA_USE_POSTGRES=1 explicitly enables the managed Docker container. Data
# lives in a named volume. Native and externally managed Postgres are untouched.
STROPHA_CONFIG_FILE="${STROPHA_CONFIG_FILE:-${HOME}/.stropha/config.yaml}"

case "${STROPHA_USE_POSTGRES:-0}" in
    1|true|yes|on)  USE_POSTGRES=1 ;;
    *)              USE_POSTGRES=0 ;;
esac

# Connection defaults (the local container). Overridden by the config `dsn:`
# so the container always matches what stropha connects to.
PG_PORT_CFG="54329"; PG_USER_CFG="stropha"; PG_PASSWORD_CFG="stropha"; PG_DB_CFG="stropha"
if [ "$USE_POSTGRES" = "1" ] && [ -f "$STROPHA_CONFIG_FILE" ]; then
    _dsn=$(grep -E '^[[:space:]]*dsn:[[:space:]]*' "$STROPHA_CONFIG_FILE" | head -1 \
        | sed -E "s/^[[:space:]]*dsn:[[:space:]]*//; s/[\"']//g; s/[[:space:]]*\$//")
    case "$_dsn" in
        postgres://*|postgresql://*)
            _rest=${_dsn#*://}                 # user:pass@host:port/db?params
            _userpass=${_rest%%@*}
            _hostportdb=${_rest#*@}
            case "$_userpass" in
                *:*) PG_USER_CFG=${_userpass%%:*}; PG_PASSWORD_CFG=${_userpass#*:} ;;
                *)   [ -n "$_userpass" ] && PG_USER_CFG=${_userpass} ;;
            esac
            _hostport=${_hostportdb%%/*}
            _db=${_hostportdb#*/}; _db=${_db%%\?*}
            [ -n "$_db" ] && PG_DB_CFG="$_db"
            case "$_hostport" in *:*) PG_PORT_CFG=${_hostport##*:} ;; esac
            ;;
    esac
fi

PG_CONTAINER="${STROPHA_PG_CONTAINER:-stropha-pg}"
PG_IMAGE="${STROPHA_PG_IMAGE:-pgvector/pgvector:pg17}"
PG_PORT="${STROPHA_PG_PORT:-$PG_PORT_CFG}"
PG_USER="${STROPHA_PG_USER:-$PG_USER_CFG}"
PG_PASSWORD="${STROPHA_PG_PASSWORD:-$PG_PASSWORD_CFG}"
PG_DB="${STROPHA_PG_DB:-$PG_DB_CFG}"
PG_VOLUME="${STROPHA_PG_VOLUME:-stropha-pgdata}"

# Auto-detect the stropha project dir from the script's location: this
# script lives at <project>/bin/stropha-mcp-ensure, so the project root
# is one directory up. Allow override via STROPHA_MCP_PROJECT_DIR.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
PROJECT_DIR="${STROPHA_MCP_PROJECT_DIR:-$(dirname "$SCRIPT_DIR")}"

mkdir -p "$(dirname "$PIDFILE")"

_is_running() {
    [ -f "$PIDFILE" ] || return 1
    PID=$(cat "$PIDFILE")
    kill -0 "$PID" 2>/dev/null || { rm -f "$PIDFILE"; return 1; }
    # Liveness only: process is up and the event loop answers /health. NOTE
    # this does NOT prove the MCP endpoint works — a deadlocked session path
    # keeps /health green while /mcp hangs (use _mcp_responsive for that). We
    # keep this cheap because _start uses it as the double-start guard.
    curl -sf -m 5 "http://${HOST}:${PORT}/health" >/dev/null 2>&1
}

# PIDs actually LISTENING on the MCP port. The pidfile tracks the `uv run`
# wrapper, and killing the wrapper orphans the python server (PPID 1), which
# keeps the port: /health then looks green from the orphan while a freshly
# started server dies on EADDRINUSE. Stop/start must therefore reconcile
# against the real listener, not just the pidfile.
_port_listeners() {
    lsof -tnP -iTCP:"${PORT}" -sTCP:LISTEN 2>/dev/null
}

_track_listener_pid() {
    # `uv run` can spawn the Python entry point and exit, making `$!` stale.
    # Once the server is ready, hand the pidfile to the sole process that
    # actually owns the listening socket.
    set -- $(_port_listeners)
    [ "$#" -eq 1 ] || return 1
    echo "$1" > "$PIDFILE"
}

_wait_for_port_release() {
    for _wait in $(seq 1 30); do
        [ -z "$(_port_listeners)" ] && return 0
        sleep 1
    done
    return 1
}

# Probe that the MCP *protocol* endpoint actually serves a request — not just
# that /health is up. A wedged daemon (event loop alive, session-handling path
# deadlocked) keeps /health green while POST /mcp never returns headers, so a
# /health-only check reports a false "running". We send a real ``initialize``
# and require HTTP response headers within the timeout, then best-effort
# terminate the throwaway session so probes don't leak sessions.
# Tunable: STROPHA_MCP_PROBE_TIMEOUT (seconds, default 8).
_mcp_responsive() {
    _probe_to="${STROPHA_MCP_PROBE_TIMEOUT:-8}"
    _hdrs=$(curl -s -m "$_probe_to" -D - -o /dev/null \
        -X POST "http://${HOST}:${PORT}/mcp" \
        -H 'Content-Type: application/json' \
        -H 'Accept: application/json, text/event-stream' \
        -d '{"jsonrpc":"2.0","id":"stropha-healthprobe","method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"stropha-mcp-ensure","version":"0"}}}' \
        2>/dev/null) || return 1
    # No HTTP status line => no response headers => wedged or unreachable.
    printf '%s\n' "$_hdrs" | grep -qi '^HTTP/' || return 1
    # Best-effort: terminate the throwaway session so the probe leaks nothing.
    _sid=$(printf '%s\n' "$_hdrs" | grep -i '^mcp-session-id:' | head -1 \
        | tr -d '\r' | sed -E 's/^[Mm][Cc][Pp]-[Ss]ession-[Ii]d:[[:space:]]*//')
    if [ -n "$_sid" ]; then
        curl -s -m "$_probe_to" -o /dev/null -X DELETE \
            "http://${HOST}:${PORT}/mcp" \
            -H "mcp-session-id: ${_sid}" >/dev/null 2>&1 || true
    fi
    return 0
}

# --- Postgres helpers --------------------------------------------------------
# Each is a no-op unless STROPHA_USE_POSTGRES=1, and each fails soft (never
# aborts the MCP lifecycle) since the DB is not yet on the read path.

_pg_container_running() {
    docker ps --filter "name=^/${PG_CONTAINER}$" --filter "status=running" \
        --format '{{.Names}}' 2>/dev/null | grep -q "^${PG_CONTAINER}$"
}

_pg_container_exists() {
    docker ps -a --filter "name=^/${PG_CONTAINER}$" \
        --format '{{.Names}}' 2>/dev/null | grep -q "^${PG_CONTAINER}$"
}

_pg_start() {
    [ "$USE_POSTGRES" = "1" ] || return 0

    if ! command -v docker >/dev/null 2>&1; then
        echo "[stropha-pg] STROPHA_USE_POSTGRES=1 but 'docker' not found; skipping" >&2
        return 0
    fi

    if _pg_container_running; then
        echo "[stropha-pg] already running (container ${PG_CONTAINER}, port ${PG_PORT})"
    elif _pg_container_exists; then
        echo "[stropha-pg] starting existing container ${PG_CONTAINER}..."
        docker start "$PG_CONTAINER" >/dev/null \
            || { echo "[stropha-pg] failed to start container ${PG_CONTAINER}" >&2; return 0; }
    else
        echo "[stropha-pg] creating container ${PG_CONTAINER} from ${PG_IMAGE}..."
        docker run -d \
            --name "$PG_CONTAINER" \
            --restart unless-stopped \
            -e POSTGRES_USER="$PG_USER" \
            -e POSTGRES_PASSWORD="$PG_PASSWORD" \
            -e POSTGRES_DB="$PG_DB" \
            -p "${PG_PORT}:5432" \
            -v "${PG_VOLUME}:/var/lib/postgresql/data" \
            "$PG_IMAGE" >/dev/null \
            || { echo "[stropha-pg] 'docker run' failed (is the image pullable?)" >&2; return 0; }
    fi

    # Auto-recover the DB after a Colima/Docker VM bounce (e.g. laptop sleep)
    # WITHOUT a manual restart. `unless-stopped` still honours an explicit
    # `--stop`. Reconcile on every start so it also applies to a pre-existing
    # container created before this flag existed (metadata-only; no recreate).
    docker update --restart=unless-stopped "$PG_CONTAINER" >/dev/null 2>&1 || true

    # Wait for readiness (up to 30s), then ensure the pgvector extension.
    i=0
    while [ "$i" -lt 30 ]; do
        if docker exec "$PG_CONTAINER" pg_isready -U "$PG_USER" -d "$PG_DB" >/dev/null 2>&1; then
            if docker exec "$PG_CONTAINER" psql -U "$PG_USER" -d "$PG_DB" \
                -c 'CREATE EXTENSION IF NOT EXISTS vector;' >/dev/null 2>&1; then
                echo "[stropha-pg] ready — postgresql://${PG_USER}:***@${HOST}:${PG_PORT}/${PG_DB} (pgvector enabled)"
            else
                echo "[stropha-pg] ready, but failed to CREATE EXTENSION vector" >&2
            fi
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    echo "[stropha-pg] warning: not ready after 30s — check 'docker logs ${PG_CONTAINER}'" >&2
    return 0
}

_pg_stop() {
    [ "$USE_POSTGRES" = "1" ] || return 0
    command -v docker >/dev/null 2>&1 || return 0
    if _pg_container_running; then
        docker stop "$PG_CONTAINER" >/dev/null 2>&1 \
            && echo "[stropha-pg] stopped (container ${PG_CONTAINER}; data kept in volume ${PG_VOLUME})"
    else
        echo "[stropha-pg] not running"
    fi
}

_pg_status() {
    [ "$USE_POSTGRES" = "1" ] || return 0
    if ! command -v docker >/dev/null 2>&1; then
        echo "[stropha-pg] docker not found"
        return 0
    fi
    if _pg_container_running; then
        echo "[stropha-pg] running (container ${PG_CONTAINER}, port ${PG_PORT})"
    else
        echo "[stropha-pg] not running"
    fi
}

_start() {
    # Bring up Postgres first (no-op unless STROPHA_USE_POSTGRES=1) so it is
    # ready even when the MCP server is already up.
    _pg_start

    if _is_running; then
        echo "[stropha-mcp] already running (pid $(cat "$PIDFILE"), port $PORT)"
        return 0
    fi

    # Not running per the pidfile, but the port may still be held by an
    # orphaned server from an earlier stop (see _port_listeners). Starting on
    # top of it would EADDRINUSE-crash the new server while the orphan keeps
    # answering /health — a false "ready" on stale code. Clear it first.
    for _lp in $(_port_listeners); do
        echo "[stropha-mcp] killing orphaned server on port ${PORT} (pid $_lp)" >&2
        kill "$_lp" 2>/dev/null || true
    done
    if ! _wait_for_port_release; then
        echo "[stropha-mcp] error: port ${PORT} did not become available" >&2
        return 1
    fi

    echo "[stropha-mcp] starting on ${HOST}:${PORT}..."

    UV="${STROPHA_HOOK_UV:-}"
    if [ -z "$UV" ]; then
        if command -v uv >/dev/null 2>&1; then
            UV=$(command -v uv)
        elif [ -x "$HOME/.local/bin/uv" ]; then
            UV="$HOME/.local/bin/uv"
        elif [ -x "/opt/homebrew/bin/uv" ]; then
            UV="/opt/homebrew/bin/uv"
        fi
    fi

    if [ -z "$UV" ]; then
        echo "[stropha-mcp] error: uv not found" >&2
        exit 1
    fi

    # STROPHA_INDEX_PATH removed in v=9 (read by no code path). The DB
    # location comes from ~/.stropha/config.yaml `paths.index`.
    STROPHA_TARGET_REPO="${STROPHA_TARGET_REPO:-$PROJECT_DIR}" \
    STROPHA_LOG_LEVEL="${STROPHA_LOG_LEVEL:-WARNING}" \
    nohup "$UV" run --directory "$PROJECT_DIR" stropha-mcp \
        --host "$HOST" \
        --port "$PORT" \
        >> "$LOGFILE" 2>&1 &

    echo $! > "$PIDFILE"
    
    # Wait for it to become healthy (up to 30s for model loading). /health
    # alone is not enough — confirm the MCP protocol endpoint actually serves
    # a request before declaring readiness, so a health-green-but-wedged start
    # is reported as a warning rather than a false "ready".
    for i in $(seq 1 30); do
        if curl -sf -m 5 "http://${HOST}:${PORT}/health" >/dev/null 2>&1 && _mcp_responsive; then
            _track_listener_pid || true
            echo "[stropha-mcp] ready (pid $(cat "$PIDFILE"), port $PORT) — /mcp responsive"
            return 0
        fi
        sleep 1
    done

    echo "[stropha-mcp] warning: started but /mcp not responding to an MCP request" >&2
    echo "[stropha-mcp] check $LOGFILE for details" >&2
}

_stop() {
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID"
            echo "[stropha-mcp] stopped (pid $PID)"
        fi
        rm -f "$PIDFILE"
    else
        echo "[stropha-mcp] not running"
    fi
    # Killing the uv wrapper does not reach the python server it spawned —
    # take down whatever still holds the port so the next start can bind.
    for _lp in $(_port_listeners); do
        kill "$_lp" 2>/dev/null && \
            echo "[stropha-mcp] stopped orphaned server on port ${PORT} (pid $_lp)"
    done
    if ! _wait_for_port_release; then
        echo "[stropha-mcp] warning: port ${PORT} is still in use" >&2
        return 1
    fi
    _pg_stop
}

_status() {
    _pg_status
    # Recover when the launcher exited after `uv` handed the process off but
    # before it could persist the listener PID.
    if ! _is_running \
        && curl -sf -m 5 "http://${HOST}:${PORT}/health" >/dev/null 2>&1 \
        && _mcp_responsive; then
        _track_listener_pid || true
    fi
    if _is_running; then
        if _mcp_responsive; then
            echo "[stropha-mcp] running (pid $(cat "$PIDFILE"), port $PORT) — /mcp responsive"
        else
            echo "[stropha-mcp] WEDGED: pid $(cat "$PIDFILE") alive and /health OK, but /mcp is not responding (port $PORT)" >&2
            echo "[stropha-mcp] recover with: $0 --stop && $0" >&2
            return 2
        fi
    else
        echo "[stropha-mcp] not running"
        return 1
    fi
}

case "${1:-}" in
    --stop)   _stop ;;
    --status) _status ;;
    *)        _start ;;
esac
