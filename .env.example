# NOTE: stropha no longer reads .env. All configuration (including
# API keys, paths, and model selection) lives in
# ``~/.stropha/config.yaml``. This file is kept as a historical
# example only.
#
# The only environment variables still honoured are:
#   STROPHA_TARGET_REPO    — runtime argument: which repo to operate on.
#   STROPHA_HOOK_*         — post-commit hook subprocess overrides
#                            (the hook is a detached shell script that
#                            cannot read YAML at runtime; values are
#                            also baked at install time).
#
# All STROPHA_INDEX_PATH / STROPHA_VOYAGE_* / STROPHA_LOCAL_* /
# STROPHA_LOG_LEVEL / STROPHA_MAX_FILE_BYTES references were removed
# in the v=9 unification — no code path reads them.
#
# Example minimal config.yaml (place at ~/.stropha/config.yaml):
#
#   secrets:
#     voyage_api_key: "pa-..."
#     anthropic_api_key: "sk-ant-..."
#
#   paths:
#     index: ~/.stropha/index.db
#
#   logging:
#     level: INFO

STROPHA_TARGET_REPO=
